{
  "name": "appium-geckodriver",
  "version": "4.0.1",
  "description": "Appium driver for Gecko-based browsers and web views",
  "keywords": [
    "appium",
    "firefox",
    "gecko",
    "geckodriver"
  ],
  "homepage": "https://appium.github.io/appium-geckodriver",
  "bugs": {
    "url": "https://github.com/appium/appium-geckodriver/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-geckodriver.git"
  },
  "bin": {},
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "build/lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/*.mjs"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "npm run build -- --clean",
    "rebuild": "npm run clean; npm run build",
    "dev": "npm run build -- --watch",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "prepare": "npm run build",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "build:docs": "appium-docs build",
    "dev:docs": "appium-docs build --serve",
    "publish:docs": "appium-docs build --deploy --push -b docs-site -m 'docs: build docs for appium-geckodriver@%s' --alias latest --use-prefixed-major-deploy-version",
    "install-docs-deps": "appium-docs init --no-mkdocs",
    "pretest": "npm run build",
    "test": "node --enable-source-maps --test --test-timeout=60000 \"build/test/unit/**/*.test.js\"",
    "e2e-test": "npm run build && node --enable-source-maps --test --test-timeout=300000 \"build/test/functional/**/*.test.js\""
  },
  "dependencies": {
    "appium-adb": "^16.0.0",
    "asyncbox": "^6.6.0",
    "axios": "^1.16.1",
    "commander": "^15.1.0",
    "portscanner": "^2.2.0",
    "semver": "^7.6.3",
    "tar-stream": "^3.1.7",
    "teen_process": "^4.0.4"
  },
  "devDependencies": {
    "@appium/docutils": "^4.0.0-beta.7",
    "@appium/oxc-config": "^2.0.0-beta.3",
    "@appium/semantic-release-config": "^2.0.0-beta.1",
    "@appium/tsconfig": "^2.0.0-beta.2",
    "@appium/types": "^2.0.0-beta.6",
    "@types/node": "^26.0.0",
    "@types/portscanner": "^2.1.4",
    "@types/tar-stream": "^3.1.4",
    "webdriverio": "^10.1.0"
  },
  "peerDependencies": {
    "appium": "^4.0.0-beta.8"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "appium": {
    "driverName": "gecko",
    "automationName": "Gecko",
    "platformNames": [
      "Linux",
      "Mac",
      "Android",
      "Windows"
    ],
    "mainClass": "GeckoDriver",
    "scripts": {
      "install-geckodriver": "./scripts/install-geckodriver.mjs"
    },
    "doctor": {
      "checks": [
        "./build/lib/doctor/required-checks.js",
        "./build/lib/doctor/optional-checks.js"
      ]
    }
  }
}
